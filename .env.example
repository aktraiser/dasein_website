# Public URL of the site (canonical URLs, hreflang, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Contact form delivery through the site's mailbox (SMTP)
SMTP_USER=contact@example.com
SMTP_PASS=
CONTACT_TO=contact@example.com
# Optional: sender shown in the inbox (defaults to SMTP_USER), and another mail server
CONTACT_FROM="Dasein <contact@example.com>"
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
